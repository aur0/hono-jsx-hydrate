{
  "name": "hono-jsx-hydrate",
  "version": "0.1.0",
  "description": "A patched Hono JSX runtime with DOM hydration for completed server-rendered HTML",
  "license": "MIT",
  "type": "module",
  "main": "./dist/hono-jsx.js",
  "types": "./src/jsx/index.ts",
  "exports": {
    "./jsx": {
      "types": "./src/jsx/index.ts",
      "import": "./dist/hono-jsx.js"
    },
    "./jsx/jsx-runtime": {
      "types": "./src/jsx/jsx-runtime.ts",
      "import": "./dist/hono-jsx-jsx-runtime.js"
    },
    "./jsx/jsx-dev-runtime": {
      "types": "./src/jsx/jsx-dev-runtime.ts",
      "import": "./dist/hono-jsx-jsx-dev-runtime.js"
    },
    "./jsx/streaming": {
      "types": "./src/jsx/streaming.ts",
      "import": "./dist/hono-jsx-streaming.js"
    },
    "./jsx/dom": {
      "types": "./src/jsx/dom/index.ts",
      "import": "./dist/hono-jsx-dom.js"
    },
    "./jsx/dom/jsx-runtime": {
      "types": "./src/jsx/dom/jsx-runtime.ts",
      "import": "./dist/hono-jsx-dom-jsx-runtime.js"
    },
    "./jsx/dom/jsx-dev-runtime": {
      "types": "./src/jsx/dom/jsx-dev-runtime.ts",
      "import": "./dist/hono-jsx-dom-jsx-dev-runtime.js"
    },
    "./jsx/dom/client": {
      "types": "./src/jsx/dom/client.ts",
      "import": "./dist/hono-jsx-dom-client.js"
    },
    "./jsx/dom/css": {
      "types": "./src/jsx/dom/css.ts",
      "import": "./dist/hono-jsx-dom-css.js"
    },
    "./jsx/dom/server": {
      "types": "./src/jsx/dom/server.ts",
      "import": "./dist/hono-jsx-dom-server.js"
    },
    "./bun": {
      "types": "./bun.d.ts",
      "import": "./bun.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "bun.js",
    "bun.d.ts",
    "runtime-entrypoints.js",
    "vite.js",
    "vite.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:hydration && npm run test:vite && npm run test:worker",
    "test:vite": "node test/vite-smoke.mjs",
    "test:worker": "node test/worker-esbuild.mjs",
    "test:bun": "bun test/bun-smoke.mjs",
    "test:rollup": "node test/rollup-smoke.mjs",
    "test:webpack": "node test/webpack-smoke.mjs",
    "test:rspack": "node test/rspack-smoke.mjs",
    "test:parcel": "node test/parcel-smoke.mjs",
    "test:rolldown": "node test/rolldown-smoke.mjs",
    "test:bundlers": "npm run test:rollup && npm run test:webpack && npm run test:rspack && npm run test:parcel && npm run test:rolldown",
    "test:deno": "deno run --allow-all test/deno-smoke.ts",
    "test:hydration": "node test/hydration-compatibility.mjs"
  },
  "peerDependencies": {
    "hono": "4.13.17",
    "vite": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rspack/core": "^2.3.2",
    "esbuild": "^0.28.2",
    "hono": "4.13.17",
    "miniflare": "^4.20260730.0",
    "parcel": "^2.16.4",
    "rolldown": "^1.3.2",
    "rollup": "^4.68.3",
    "vite": "^8.3.8",
    "webpack": "^5.112.2"
  }
}
